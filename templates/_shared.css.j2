/* Included raw into a <style> tag -- no Jinja syntax below. A literal
   double-curly or curly-percent in a future edit here would be parsed as a
   template expression. */
:root{
  --paper:#F7F6F2; --card:#FFFEFB; --ink:#16181C; --ink-2:#5C5F66; --ink-3:#8B8D93;
  --rule:#DEDBD2; --rule-soft:#EBE8E0;
  --accent:#1D4E6F; --accent-soft:#E4EDF2;
  --flag:#7A1F3D; --flag-soft:#F3E3E8;
  --sans:"IBM Plex Sans Condensed",ui-sans-serif,"Helvetica Neue",Arial,sans-serif;
  --serif:"IBM Plex Serif",Georgia,"Times New Roman",serif;
  --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --rail:16.5rem;
}
html[data-theme="dark"],
:root:not([data-theme="light"]) {}
@media (prefers-color-scheme: dark){
  html:not([data-theme="light"]){
    --paper:#14161A; --card:#191C21; --ink:#E9E7E1; --ink-2:#A2A5AC; --ink-3:#75787F;
    --rule:#2A2E35; --rule-soft:#22262C;
    --accent:#7FB3CE; --accent-soft:#1B2A33;
    --flag:#D89AAB; --flag-soft:#2E1E25;
  }
}
html[data-theme="dark"]{
  --paper:#14161A; --card:#191C21; --ink:#E9E7E1; --ink-2:#A2A5AC; --ink-3:#75787F;
  --rule:#2A2E35; --rule-soft:#22262C;
  --accent:#7FB3CE; --accent-soft:#1B2A33;
  --flag:#D89AAB; --flag-soft:#2E1E25;
}

*{box-sizing:border-box}
body{
  margin:0; background:var(--paper); color:var(--ink);
  font-family:var(--serif); font-size:16px; line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit}
a:focus-visible,button:focus-visible,summary:focus-visible{
  outline:2px solid var(--accent); outline-offset:3px; border-radius:2px;
}

/* ---------- rail ---------- */
.rail{
  position:fixed; inset:0 auto 0 0; width:var(--rail); padding:2rem 1.5rem;
  border-right:1px solid var(--rule); display:flex; flex-direction:column; gap:1.75rem;
  overflow-y:auto;
}
.masthead .wordmark{
  font-family:var(--sans); font-weight:700; font-size:1.5rem; letter-spacing:.02em;
  text-transform:uppercase; margin:0; line-height:1;
}
.masthead .rule{height:3px; background:var(--ink); margin:.55rem 0 .5rem}
.masthead .edition{
  font-family:var(--mono); font-size:.72rem; color:var(--ink-2);
  text-transform:uppercase; letter-spacing:.08em;
}
nav ol{list-style:none; margin:0; padding:0}
nav li{border-bottom:1px solid var(--rule-soft)}
nav a{
  display:flex; align-items:baseline; gap:.6rem; padding:.5rem 0;
  text-decoration:none; font-family:var(--sans); font-weight:600; font-size:.95rem;
}
nav a:hover,nav a.active{color:var(--accent)}
nav .idx{font-family:var(--mono); font-size:.68rem; color:var(--ink-3); width:1.1rem}
nav .n{margin-left:auto; font-family:var(--mono); font-size:.72rem; color:var(--ink-3)}
.rail-foot{margin-top:auto; font-family:var(--mono); font-size:.68rem; color:var(--ink-3); line-height:1.7}
.rail-foot dl{display:grid; grid-template-columns:auto 1fr; gap:.1rem .6rem; margin:0 0 .9rem}
.rail-foot dt{color:var(--ink-3)}
.rail-foot dd{margin:0; color:var(--ink-2)}
kbd{
  font-family:var(--mono); font-size:.66rem; border:1px solid var(--rule);
  border-bottom-width:2px; border-radius:3px; padding:0 .28rem; color:var(--ink-2);
}
.tools{display:flex; gap:.4rem; margin-bottom:.9rem}
.tools button, .tools a{
  font-family:var(--mono); font-size:.68rem; text-transform:uppercase; letter-spacing:.06em;
  background:none; border:1px solid var(--rule); color:var(--ink-2);
  padding:.3rem .5rem; border-radius:3px; cursor:pointer;
  text-decoration:none; display:inline-block;
}
.tools button:hover, .tools a:hover{border-color:var(--accent); color:var(--accent)}

/* ---------- main ---------- */
main{margin-left:var(--rail); padding:2.5rem 3rem 6rem; max-width:60rem}
.filter{
  position:sticky; top:0; z-index:5; background:var(--paper);
  padding:.35rem 0 1rem; margin-bottom:.5rem;
}
.filter input{
  width:100%; font-family:var(--mono); font-size:.82rem; color:var(--ink);
  background:var(--card); border:1px solid var(--rule); border-radius:3px;
  padding:.55rem .7rem;
}
.filter input::placeholder{color:var(--ink-3)}

.topic{margin-bottom:3.5rem; scroll-margin-top:4rem}
.topic-head{border-top:2px solid var(--ink); padding-top:.6rem; margin-bottom:1.25rem}
.eyebrow{
  font-family:var(--mono); font-size:.68rem; text-transform:uppercase; letter-spacing:.12em;
  color:var(--ink-3); display:flex; gap:.75rem; align-items:center;
}
.topic-head h2{
  font-family:var(--sans); font-weight:700; font-size:1.9rem; letter-spacing:-.01em;
  margin:.15rem 0 0; line-height:1.15;
}

.brief-tabs{display:flex; gap:.4rem; margin-bottom:.6rem; flex-wrap:wrap}
.brief-tab{
  font-family:var(--mono); font-size:.68rem; text-transform:uppercase; letter-spacing:.06em;
  background:none; border:1px solid var(--rule); color:var(--ink-2);
  padding:.3rem .6rem; border-radius:3px; cursor:pointer;
}
.brief-tab:hover{border-color:var(--accent); color:var(--accent)}
.brief-tab.active{border-color:var(--accent); color:var(--accent); background:var(--accent-soft)}
.brief{
  background:var(--card); border:1px solid var(--rule); border-left:3px solid var(--accent);
  padding:1.1rem 1.3rem; margin-bottom:1.75rem; font-size:.97rem;
}
.brief[hidden]{display:none}
.brief > :first-child{margin-top:0}
.brief > :last-child{margin-bottom:0}
.brief h4{
  font-family:var(--mono); font-size:.7rem; text-transform:uppercase; letter-spacing:.1em;
  color:var(--accent); margin:1.1rem 0 .4rem; font-weight:600;
}
.brief ul{margin:.3rem 0 .7rem; padding-left:1.1rem}
.brief li{margin-bottom:.3rem}

/* ---------- story ---------- */
.story{
  display:grid; grid-template-columns:2.6rem 1fr; gap:0 1rem;
  padding:1.15rem 0; border-bottom:1px solid var(--rule-soft);
}
.story.cursor{background:var(--accent-soft); box-shadow:-1rem 0 0 var(--accent-soft), 1rem 0 0 var(--accent-soft)}
.story[hidden]{display:none}

/* signature element: the signal meter */
.signal{display:flex; flex-direction:column; gap:2px; padding-top:.4rem; cursor:help}
.signal .seg{height:4px; background:var(--rule); border-radius:1px}
.signal .seg.on{background:var(--accent)}
.story.corroborated .signal .seg.on{background:var(--flag)}
.signal .val{
  font-family:var(--mono); font-size:.62rem; color:var(--ink-3); margin-top:.25rem;
  letter-spacing:-.02em;
}

.story h3{
  font-family:var(--sans); font-weight:600; font-size:1.18rem; line-height:1.3;
  margin:0 0 .35rem; letter-spacing:-.005em;
}
.story h3 a{text-decoration:none}
.story h3 a:hover{text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:3px}
.meta{
  font-family:var(--mono); font-size:.7rem; color:var(--ink-3);
  display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; margin-bottom:.5rem;
}
.meta .src{color:var(--ink-2); font-weight:500}
.meta .chip{
  border:1px solid var(--rule); border-radius:2px; padding:0 .3rem; color:var(--ink-3);
}
.meta .chip.hit{border-color:var(--accent); color:var(--accent)}
.meta .chip.multi{border-color:var(--flag); color:var(--flag); background:var(--flag-soft)}

.blurb{margin:.2rem 0 0; color:var(--ink-2); font-size:.92rem}
details.summary{margin-top:.55rem}
details.summary > summary{
  font-family:var(--mono); font-size:.68rem; text-transform:uppercase; letter-spacing:.09em;
  color:var(--accent); cursor:pointer; list-style:none;
}
details.summary > summary::-webkit-details-marker{display:none}
details.summary > summary::before{content:"+ "; }
details.summary[open] > summary::before{content:"\2212 "}
.summary-tabs{display:flex; gap:.35rem; margin:.6rem 0 .3rem; flex-wrap:wrap}
.summary-tab{
  font-family:var(--mono); font-size:.64rem; text-transform:uppercase; letter-spacing:.05em;
  background:none; border:1px solid var(--rule); color:var(--ink-3);
  padding:.22rem .5rem; border-radius:3px; cursor:pointer;
}
.summary-tab:hover{border-color:var(--accent); color:var(--accent)}
.summary-tab.active{border-color:var(--accent); color:var(--accent); background:var(--accent-soft)}
.summary-body{
  font-size:.93rem; border-left:1px solid var(--rule); padding-left:1rem;
  margin-top:.6rem; color:var(--ink);
}
.summary-body[hidden]{display:none}
.summary-body h4{
  font-family:var(--mono); font-size:.68rem; text-transform:uppercase; letter-spacing:.1em;
  color:var(--ink-3); margin:1rem 0 .35rem; font-weight:600;
}
.summary-body > :first-child{margin-top:0}
.summary-body ul{margin:.25rem 0 .6rem; padding-left:1.05rem}
.summary-body li{margin-bottom:.25rem}
.also{
  margin-top:.5rem; font-family:var(--mono); font-size:.7rem; color:var(--ink-3);
  display:flex; flex-wrap:wrap; gap:.4rem; align-items:center;
}
.also a{color:var(--ink-2); text-decoration:none; border-bottom:1px dotted var(--rule)}
.also a:hover{color:var(--accent)}
.empty{
  font-family:var(--mono); font-size:.8rem; color:var(--ink-3);
  border:1px dashed var(--rule); padding:1.1rem; text-align:center;
}

@media (max-width:900px){
  /* No pointer rail and no keyboard: fold the nav into a scrolling strip
     so the first story is above the fold. */
  .rail{
    position:static; width:auto; inset:auto; border-right:none;
    border-bottom:1px solid var(--rule); gap:.9rem; padding:1.25rem 1.25rem .75rem;
  }
  .masthead .wordmark{font-size:1.25rem}
  nav ol{display:flex; gap:1.1rem; overflow-x:auto; padding-bottom:.5rem; scrollbar-width:none}
  nav ol::-webkit-scrollbar{display:none}
  nav li{border-bottom:none; flex:0 0 auto}
  nav a{padding:0; font-size:.85rem; white-space:nowrap}
  nav .idx{display:none}
  nav .n{margin-left:.3rem}
  .rail-foot{margin-top:0}
  .rail-foot dl, .rail-foot > div:last-child{display:none}
  .tools{margin-bottom:0}
  main{margin-left:0; padding:1.25rem 1.25rem 4rem}
  .topic-head h2{font-size:1.5rem}
  .story{grid-template-columns:2.2rem 1fr; gap:0 .75rem}
  .story.cursor{box-shadow:none}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important; scroll-behavior:auto!important}}
@media print{.rail,.filter{display:none} main{margin:0; max-width:none}}
